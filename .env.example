# Paperless AI Classifier — example configuration
# The guided setup (install.sh / python -m app.setup) writes a complete .env with
# comments for every setting. This file lists the essentials for a manual start.

PAPERLESS_URL=http://localhost:8000
PAPERLESS_TOKEN=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Low temperature = consistent names
OLLAMA_TEMPERATURE=0.1
# Context window and output cap; thinking off; JSON-schema constrained answers
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_THINK=false
OLLAMA_STRUCTURED_OUTPUT=true
# Model stays in RAM this long after a request; true = unload as soon as the queue is empty
OLLAMA_KEEP_ALIVE=5m
OLLAMA_UNLOAD_WHEN_IDLE=false

# Page images are the primary input. 1-2 pages are usually enough on slow hardware.
MAX_PAGES=3
IMAGE_MAX_SIZE=1024
# Paperless' OCR text: off (recommended) | hint | only
OCR_TEXT_MODE=off

AUTO_COMMIT=true
OVERWRITE_EXISTING=false
TAGS_MODE=merge
SKIP_CLASSIFIED=true

POLL_INTERVAL=60
API_HOST=0.0.0.0
API_PORT=8001
